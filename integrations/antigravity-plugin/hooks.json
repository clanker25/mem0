{
  "mem0": {
    "PreInvocation": [
      { "type": "command", "command": "python3 ./hooks/adapter.py PreInvocation", "timeout": 5 }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "python3 ./hooks/adapter.py PostToolUse", "timeout": 4 }
        ]
      }
    ],
    "Stop": [
      { "type": "command", "command": "python3 ./hooks/adapter.py Stop", "timeout": 5 }
    ]
  }
}
